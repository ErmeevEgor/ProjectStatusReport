{
  "name": "project-status-report",
  "version": "0.8.1",
  "status": "release",
  "runtime": {
    "python": ">=3.11",
    "dependencies": [
      "python-docx>=1.2.0"
    ]
  },
  "outputs": [
    "report-data.json",
    "sources.json"
  ],
  "output_modes": {
    "docx": [
      "working.docx",
      "clean.docx"
    ],
    "confluence_storage": [
      "confluence-storage.xml"
    ]
  },
  "docx_pages": 4
}
